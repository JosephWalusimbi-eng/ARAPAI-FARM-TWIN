# Copy to .env (git-ignored) and fill in ONE of the two options.

# Option 1 (preferred): token from https://urs.earthdata.nasa.gov > Profile > Generate Token
EARTHDATA_TOKEN=

# Option 2: Earthdata username and password
# EARTHDATA_USERNAME=
# EARTHDATA_PASSWORD=

# Optional: skip the blocked POWER API host and read the AWS archive directly
# FARM_TWIN_POWER_SOURCE=s3

# Sunbird AI (Ugandan-language translation), from https://sunbird.ai
SUNBIRD_API_TOKEN=

# Basic-phone channel (defaults are simulated)
# SMS_GATEWAY=africastalking
# AT_USERNAME=sandbox
# AT_API_KEY=
# MOMO_MODE=sandbox
# MOMO_SUBSCRIPTION_KEY=        # MTN MoMo developer portal > Collections > primary key
# FARM_TWIN_SIMULATOR=0         # turn the /simulator routes off where real users can reach

# Extra Sunbird keys, used in order if the first is rate limited (optional):
SUNBIRD_API_TOKEN_2=
SUNBIRD_API_TOKEN_3=
